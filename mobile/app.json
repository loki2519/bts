{
  "expo": {
    "name": "BTS WORLD",
    "slug": "bts-world",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0410"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.katdigital.btsworld"
    },
    "android": {
      "package": "com.katdigital.btsworld",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0410"
      },
      "permissions": ["INTERNET"]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "scheme": "btsworld"
  }
}
